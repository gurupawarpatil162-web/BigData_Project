   "source": [
    "SELECT\n",
    "    playlist_genre,\n",
    "    ROUND(AVG(danceability),2) AS danceability,\n",
    "    ROUND(AVG(energy),2) AS energy,\n",
    "    ROUND(AVG(valence),2) AS happiness\n",
    "FROM main.default.silver_spotify\n",
    "GROUP BY playlist_genre;"
